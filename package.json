{
  "name": "lens-physics-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src shared server tests scripts vite.config.ts",
    "typecheck": "tsc --noEmit",
    "discovery:contract": "node --import tsx docs/detection/v2/check-contract.ts",
    "discovery:preflight": "node --import tsx scripts/discovery-preflight.ts",
    "discovery:evaluate": "node --import tsx scripts/discovery-evaluate.ts",
    "discovery:smoke": "node --import tsx scripts/discovery-smoke.ts",
    "discovery:archive": "node scripts/archive-implementation.mjs",
    "users:create-table": "node scripts/create-users-table.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.922.0",
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@napi-rs/canvas": "^1.0.9",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
