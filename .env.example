# Set credentials locally. Never put them in the client or commit them.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Standard short-lived AWS credentials, or use an existing AWS_PROFILE:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# Optional Bedrock API key (Bearer authentication, server only):
# AWS_BEARER_TOKEN_BEDROCK=
PORT=8787
# Set to false to keep rehearsal mode even when credentials exist.
BEDROCK_ENABLED=true
