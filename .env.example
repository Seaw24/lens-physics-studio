# Set credentials locally. Never put them in the client or commit them.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Standard short-lived AWS credentials, or use an existing AWS_PROFILE:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# Optional Bedrock API key (Bearer authentication, server only):
# AWS_BEARER_TOKEN_BEDROCK=
PORT=8787
# User accounts: set USERS_TABLE_NAME for DynamoDB, or omit for local JSON storage.
# Name must match the console exactly (e.g. momentum_users). Table needs GSI email-index on email.
# USERS_TABLE_NAME=momentum_users
# AUTH_RUNTIME_ROOT=.runtime/users
# Set to false to keep rehearsal mode even when credentials exist.
BEDROCK_ENABLED=true

# Discovery v2. The access code is server-only.
# If omitted, a random code is printed once when the local server starts.
DISCOVERY_ENABLED=true
DISCOVERY_PROPOSER_MODEL_ID=amazon.nova-lite-v1:0
DISCOVERY_REVIEWER_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Writes learned lessons from labeled cases (text only).
DISCOVERY_DRAFTER_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Shared login code for the studio (at least 4 characters); generated per run when unset.
# DISCOVERY_ACCESS_CODE=
# Optional separate server-to-server bearer; never embed it in browser code.
# DISCOVERY_CONTROLLER_BEARER_TOKEN=
# Optional workshop JSON containing AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN.
# DISCOVERY_CREDENTIALS_FILE=.runtime/vision-evaluation/workshop-credentials.json
DISCOVERY_BIND_HOST=127.0.0.1
# Required for phone pairing; use the trusted HTTPS LAN origin exactly.
# DISCOVERY_PUBLIC_ORIGIN=https://192.168.1.20:8787
# DISCOVERY_TLS_CERT=.runtime/discovery/tls/lens.pem
# DISCOVERY_TLS_KEY=.runtime/discovery/tls/lens-key.pem
# Optional verified overrides; bundled development executables are used otherwise.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
